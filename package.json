{
  "name": "babyjoy-web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "test:production-rollout": "vitest run tests/production-cron.test.ts tests/production-rollout-workflow.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply babyjoy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply babyjoy-db --remote",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "test:e2e:rich-description": "node tests/product-rich-description.e2e.mjs",
    "test:e2e:cart-requests": "node tests/admin-cart-requests.e2e.mjs",
    "test:e2e:empty": "node tests/empty-catalog.e2e.mjs",
    "test:e2e:promotion-selector": "node tests/promotion-selector.e2e.mjs",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-color": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-text-style": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "isbot": "^5.1.36",
    "jose": "^6.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}

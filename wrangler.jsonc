{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babyjoy-web-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "META_PAGE_ID": "test-page",
    "MESSENGER_PAGE_USERNAME": "babyjoy-test",
    "META_GRAPH_API_VERSION": "v26.0",
    "MESSENGER_CHECKOUT_ENABLED": "false",
    "DIRECT_SELLER_SHARE_ENABLED": "true"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "babyjoy-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "PRODUCT_IMAGES", "bucket_name": "babyjoy-product-images" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "upload_source_maps": true,
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": ["CART_SHARE_SECRET"]
      },
      "routes": [
        { "pattern": "metraphuong.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "metraphuong.cloudflareaccess.com",
        "ACCESS_AUD": "a6fb2fc920581c374a4f7509800f1e2d6d370938cf70d365a1ad26de64c8e057",
        "META_PAGE_ID": "",
        "MESSENGER_PAGE_USERNAME": "",
        "META_GRAPH_API_VERSION": "v26.0",
        "MESSENGER_CHECKOUT_ENABLED": "false",
        "DIRECT_SELLER_SHARE_ENABLED": "true"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "babyjoy-db", "database_id": "6d19fcf2-6385-493b-a377-a31d5e42de03", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "PRODUCT_IMAGES", "bucket_name": "babyjoy-product-images" }
      ]
    }
  }
}
